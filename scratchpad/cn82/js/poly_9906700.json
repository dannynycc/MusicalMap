家威廉·萨默赛特·毛姆创作的长篇小说改编而成。查尔斯·斯特里克兰德是一位家庭美满事业成功的知名股票证券经经济人，在中年时突然离开家庭，从伦敦奔赴巴黎学画，他忍受贫困，疾病与世人的不解，只为追逐内心狂热的艺术之火，在南太平洋塔希提岛与土著少女爱塔相爱，远离文明、沉浸创作。最终斯特里克兰德染上重病，在失明中完成震撼壁画，却命将其付之一炬。全剧层层剥开这位天才纯粹的灵魂：他放弃了象征世俗幸福的“六便士”，只为仰望心中那轮高悬的“月亮”。</span></p><p style=\"text-align: center;\"><span style=\"color: rgb(0, 0, 0);\"> </span><img src=\"https://cdn.polyt.cn/png/2026-08-28/14a70528b02e4b11bed38fefbbef4437.png\" alt=\"\" data-href=\"\" style=\"\"></p>", "projectImgs": [], "pxqProductId": null, "returnTicketSet": "1", "salesType": "0", "selfSupport": true, "shelfStatus": true, "shellBeforeStatus": "13", "showBefore": 3, "showDesc": null, "showLasts": "", "showPlaceAddress": "安徽省合肥市蜀山区天鹅湖路516号", "showPlaceName": "合肥大剧院", "showSaleBeginTime": true, "showSeatMap": null, "showStartToEndTime": "2026.10.23-10.24", "site": 0, "tagImg": ["https://cdn.polyt.cn/png/2025-04-18/0f0ff9f40c4924a9998bd74694abc764.png"], "theaterId": 3377, "theaterNameForIo": "合肥大剧院", "thirdProductStatus": null, "ticketAgent": true, "tourId": null, "video": null, "videoImg": null, "whetherToShowSelfLabel": true, "xiaoGuoSite": false}, "errors": null, "ext": {}, "state": "SUCCESS", "success": true}