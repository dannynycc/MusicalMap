__pycache__/
*.pyc
.DS_Store
*.log
tmp/
preview_*.png
# secrets — never commit API keys
.gmaps_key
*.gmaps_key
scrapers/.gmaps_key
.tm_key
scrapers/.tm_key
# debug artifacts (logs, audit reports) — anything data/_*
data/_*
# Node (opencc-js for the i18n build) — deps installed in CI, never committed
node_modules/
package-lock.json

# Cloudflare Analytics 查詢 token(僅本機,絕不入庫)
.cf_analytics_token
scrapers/.cf_analytics_token
data/synopses_draft/

# 韓國批查證用的官方詳情圖(下載自 Interpark)—— 絕不入庫:
# ①這是商業演出的海報與詳情長圖,public repo 等於公開再散布;②單次就 387MB。
# 判讀結果都已寫進 scratchpad/kr/p4_ledger.json 的逐字原文,圖本身不需要保留在版控裡。
scratchpad/kr/detail_img/
scratchpad/kr/sheet/
scratchpad/kr/poster/
scratchpad/kr/cmp/
scratchpad/kr/img/

# 🚨 中國批的官方詳情長圖:307MB 商業圖,絕不可進 public repo
# (與 scratchpad/kr/img/ 同理;曾經一次誤入 803 檔 387MB)
scratchpad/cn82/img/
# 🚨 讀圖過程產生的【衍生圖】也一律不進 repo:
#    sheet=接觸表、crop/zoom=裁切放大、seg=分段。都是商業圖的再製,同樣不可散布。
#    (2026-09-04 抓到:只擋了 img/,這四個資料夾漏掉,已有 7 檔進入索引)
scratchpad/cn82/sheet/
scratchpad/cn82/crop/
scratchpad/cn82/zoom/
scratchpad/cn82/seg/
# 2026-09-04 補:主視覺海報(從 china_damai.json 的 image 欄重抓)與重查用的暫存圖。
# 🚨 這次是【先擋再抓】——上一次 kr 就是抓完才想到寫 .gitignore,而 .gitignore 對
#    已被追蹤的檔案無效,結果 129 張 74MB 商業海報留在 public repo 的 HEAD 上近三天。
scratchpad/cn82/poster/
scratchpad/cn82/_recheck/

# scratchpad 裡以 _ 開頭的 .txt 是一次性診斷輸出(字形統計、洩漏掃描、風險排序…),
# 隨時可以重跑產生,不該進版控。結論都已寫進 ledger.json / verify_log.json。
scratchpad/*/_*.txt

# 套用修正前的備份快照(用來跑守門前後差異比對),驗完就可刪,不進版控。
scratchpad/*/*.prefix.json
